rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isAuth()  { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    // True only if the caller's own user doc already lists this episode key in
    // likedEpisodes — ties the episodeStats counter to the toggle the client
    // already writes to users/{uid} first, so a like/unlike can't be spammed
    // by calling this collection directly without going through that write.
    function hasLiked(id) {
      return isAuth() &&
        id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('likedEpisodes', []);
    }

    // ── Dramas — public read, admin write ──────────────────────
    // Authenticated users may update only the aggregate rating fields
    // (written by useRating after a user submits a star rating).
    match /dramas/{dramaId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuth()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['rating', 'ratingCount', 'ratingDist']);
    }

    // ── Episodes (sub-collection) — public read, admin write ──
    match /dramas/{dramaId}/episodes/{epId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Banners — public read, admin write ────────────────────
    match /banners/{page} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Users — owner read/write; admin full access ────────────
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      // Users can update their own doc but cannot change isAdmin or plan,
      // and can only ever decrease their own "coins" (spending points) —
      // crediting points happens server-side (Kursinha webhook, Admin SDK).
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['isAdmin', 'plan', 'status'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins'])
                            || request.resource.data.coins <= resource.data.coins));
      allow create: if isOwner(uid);
      // Owners can delete their own profile (perfil "Eliminar conta" flow) —
      // was admin-only, which meant that flow silently failed to actually
      // remove a regular user's Firestore data.
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Orders — owner read; admin full access; webhook creates ─
    match /orders/{orderId} {
      allow read:   if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      // No client-side create — the webhook uses the Admin SDK, which bypasses these rules
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Ratings — authenticated read; owner write ──────────────
    // ratingId format: {dramaId}_{userId}
    // Validates: value is 1–5, userId matches the caller, no extra fields injected.
    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if isAuth()
                   && request.resource.data.userId == request.auth.uid
                   && request.resource.data.rating is number
                   && request.resource.data.rating >= 1
                   && request.resource.data.rating <= 5;
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
    }

    // ── Campaigns — public read, admin write ──────────────────
    match /campaigns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Packages — public read, admin write ───────────────────
    match /packages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Episode URLs — admin/server only, never client-readable ─
    // Real video URLs for paid (non-free) episodes live here instead of on the
    // public "dramas" doc, so a locked episode's video can't be read directly
    // by anyone with a Firestore SDK. Only the Admin SDK (used by
    // /api/episode-url after it verifies the caller unlocked this episode)
    // and the admin panel may read/write this collection.
    match /episodeUrls/{key} {
      allow read, write: if isAdmin();
    }

    // ── Episode stats (likes counter) — public read, authenticated write ─
    // Clients only ever toggle a like, so "likes" may only move by exactly ±1
    // (or be created at exactly 1) per write — and only in the direction that
    // matches whether the caller has actually liked this episode according to
    // their own user doc, so the counter can't be inflated/deflated by calling
    // this collection directly without the matching users/{uid} write.
    match /episodeStats/{id} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.likes == 1
                    && hasLiked(id);
      allow update: if isAuth()
                    && request.resource.data.likes is number
                    && ((request.resource.data.likes == resource.data.likes + 1 && hasLiked(id))
                        || (request.resource.data.likes == resource.data.likes - 1 && !hasLiked(id)));
    }

    // ── Notifications (push history) — public read, admin write ─
    // Read by all signed-in users (notification bell in the nav); only the
    // admin can send/create notifications.
    match /notifications/{id} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Site visit counters — admin-only read, public increment-by-1 write ──
    // Visitors (including signed-out ones) need to write a hit on every new
    // session, but may only ever move "total"/"count" by exactly +1 — never
    // set an arbitrary value or touch any other field.
    match /analytics/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['total'])
                    && request.resource.data.total == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total'])
                    && request.resource.data.total == resource.data.total + 1;

      match /daily/{date} {
        allow read: if isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
                      && request.resource.data.count == resource.data.count + 1;
      }
    }
  }
}
